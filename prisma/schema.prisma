// Wellness Hub (EvolveWell) — Prisma schema (SQLite)
// Domain model cloned from the reference app: a login User (the full auth
// ladder is kept from the chassis — verification, reset, tokenVersion)
// plus the wellness entities decoded live from the reference's base44
// API: workouts, mood entries, assignments, events, study resources,
// reminders, goals, badges/achievements, routine templates (seeded
// content with steps), scheduled user routines, tutorials (seeded
// content) and a per-user preferences singleton (theme + notifications).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("user") // user (the reference's account tab shows "user")
  // WH-4 (F-1): avatarColor + photoUrl retired — the CRM-era avatar chain
  // (set at signup, carried in the session, never rendered: the reference
  // has no avatar surface and its account card is read-only, live-probed).
  // Email-verification funnel (kept from the chassis): NULL
  // verificationExpiresAt = no verification pending; the code is stored
  // HASHED (scrypt) — the plaintext rides only the server console log.
  verificationCodeHash   String?
  verificationAttempts   Int      @default(0)
  verificationExpiresAt  DateTime?
  // Revocation dimension (kept): every session token embeds tokenVersion
  // at mint time; a password reset increments it and every previously
  // minted cookie dies at the getSessionUser comparison.
  tokenVersion Int @default(0)
  // Password-reset funnel (kept): the column stores hashResetToken(token) —
  // the SHA-256 hex of the raw token (the hashed-at-rest posture, the same
  // as verificationCodeHash); the raw token lives only in the delivery
  // URL. Single-use, consumed ATOMICALLY via a conditional updateMany.
  // 60-minute TTL.
  resetToken           String?
  resetTokenExpiresAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workouts       Workout[]
  moodEntries    MoodEntry[]
  assignments    Assignment[]
  events         Event[]
  studyResources StudyResource[]
  reminders      Reminder[]
  goals          Goal[]
  userBadges     UserBadge[]
  routines       UserRoutine[]
  prefs          UserPrefs?
}

model Workout {
  id              String   @id @default(cuid())
  userId          String
  type            String // cardio | strength | yoga | sports | walking | cycling | swimming | other
  durationMinutes Int
  intensity       String   @default("moderate") // light | moderate | intense
  caloriesBurned  Int?
  notes           String?
  date            DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model MoodEntry {
  id         String   @id @default(cuid())
  userId     String
  mood       String // amazing | good | okay | low | struggling
  energy     Int      @default(5) // 0..10 (the reference's slider default)
  activities String? // JSON string array (the reference's tag list)
  gratitude  String?
  reflection String?
  date       DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Assignment {
  id             String    @id @default(cuid())
  userId         String
  title          String
  description    String?
  subject        String?
  dueDate        DateTime?
  priority       String    @default("medium") // low | medium | high | urgent
  estimatedHours Float?
  status         String    @default("pending") // pending | completed
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Event {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  date        DateTime
  time        String? // "HH:mm" 24h (display formats to 12h)
  category    String   @default("personal") // personal | work | social | health | education | other
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model StudyResource {
  id            String    @id @default(cuid())
  userId        String
  title         String
  subject       String
  description   String?
  type          String    @default("notes") // notes | video | practice_test | textbook | article | website | flashcards | other
  examDate      DateTime?
  url           String?
  tags          String? // JSON string array
  personalNotes String?
  rating        Int? // 1..5 (the reference's 5-star input)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, subject])
}

model Reminder {
  id          String    @id @default(cuid())
  userId      String
  title       String
  details     String?
  remindAt    DateTime
  type        String    @default("custom") // custom | assignment | event | goal | routine
  priority    String    @default("medium") // low | medium | high | urgent
  repeat      String    @default("none") // none | daily | weekly | monthly
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, remindAt])
}

model Goal {
  id           String    @id @default(cuid())
  userId       String
  title        String
  description  String?
  category     String    @default("personal") // exercise | mental_health | learning | productivity | personal | other
  frequency    String    @default("one_time") // daily | weekly | monthly | yearly | one_time
  targetValue  Int
  currentValue Int       @default(0)
  unit         String
  deadline     DateTime?
  points       Int       @default(0) // awarded on completion (frequency-derived)
  status       String    @default("active") // active | completed
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// Badge catalog — seeded definitions (the reference keeps its achievement
// vocabulary in code; we promote it to data so the count "of N total" is
// real and extensible).
model Badge {
  id          String @id @default(cuid())
  key         String @unique
  name        String
  description String
  icon        String // emoji
  color       String // tint hex for the card chip
  points      Int    @default(0)
  sortOrder   Int    @default(0)

  userBadges UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

// Routine templates — SEEDED content (the reference ships 10, decoded
// live from its RoutineTemplate entity API: name, description, category,
// time_of_day, duration, difficulty, tasks[], benefits[],
// tips_for_procrastinators, video_url, thumbnail).
model RoutineTemplate {
  id                     String  @id @default(cuid())
  key                    String  @unique
  name                   String
  description            String
  category               String // morning | exercise | study | evening | selfcare | creative | productivity
  timeOfDay              String
  duration               String // display string ("5 minutes")
  difficulty             String // easy | moderate
  benefits               String? // JSON string array
  tipsForProcrastinators String?
  videoUrl               String?
  thumbnail              String?
  sortOrder              Int     @default(0)

  steps   RoutineStep[]
  routines UserRoutine[]
}

model RoutineStep {
  id          String @id @default(cuid())
  templateId  String
  title       String
  duration    String // display string ("1 min")
  description String?
  sortOrder   Int    @default(0)

  template RoutineTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

// A user's scheduled routine — created from the "Use This Template"
// dialog (or custom, superset) with date/time/notes.
model UserRoutine {
  id          String    @id @default(cuid())
  userId      String
  templateId  String?
  title       String
  date        DateTime
  time        String?
  notes       String?
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  template RoutineTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

// Tutorials — SEEDED content (the reference ships 12, decoded live from
// its Tutorial entity API: title, description, category, video_url,
// thumbnail, duration, difficulty, views).
model Tutorial {
  id          String @id @default(cuid())
  key         String @unique
  title       String
  description String
  category    String // productivity | life_skills | mental_health | wellness | study_skills | exercise
  videoUrl    String?
  thumbnail   String?
  duration    String // display string ("8:45")
  difficulty  String // beginner | intermediate
  views       Int    @default(0)
  sortOrder   Int    @default(0)
}

// Per-user preferences singleton — the Profile & Customization tab's
// persistence (theme mode, colors, font, sidebar/card/animation styles,
// notification toggles). The client theme-store applies instantly via
// localStorage; this row is the cross-device sync (superset).
model UserPrefs {
  id                  String   @id @default(cuid())
  userId              String   @unique
  themeMode           String   @default("light") // light | dark | auto
  primaryColor        String   @default("#6366f1")
  secondaryColor      String   @default("#a855f7")
  fontFamily          String   @default("system") // system | inter | poppins | roboto | lora
  bgImageUrl          String?
  sidebarStyle        String   @default("gradient") // gradient | solid | minimal
  cardStyle           String   @default("elevated") // elevated | flat | outline
  animationLevel      String   @default("full") // full | subtle | none
  notificationsEnabled Boolean @default(true)
  weeklyReminders     Boolean @default(true)
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
