# Wellness Hub — copy to .env and adjust. SQLite keeps the zero-config local story:
#   bun run db:push && bun run db:seed
# The path is resolved relative to prisma/schema.prisma.

# ---- Database -------------------------------------------------------------
# SQLite by default (zero-config local dev). The `db/` folder lives at the
# repo root, git-ignored. A RELATIVE `file:` URL is resolved against
# prisma/schema.prisma — exactly like the Prisma CLI — so `file:../db/custom.db`
# points at <repo>/db/custom.db for the CLI (migrate/seed), `next build`, and
# the running server alike, regardless of the process working directory.
# (src/lib/db-path.ts implements this resolution; tests/db-path.test.ts
# pins the contract.)
# For production, an ABSOLUTE path is still recommended — see
# docs/DEPLOYMENT.md §4.
# To use PostgreSQL:
#   1. Set provider = "postgresql" in prisma/schema.prisma
#   2. Set DATABASE_URL to a PostgreSQL connection string
#   3. bun run db:push && bun run db:seed
DATABASE_URL="file:../db/custom.db"
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/wellness_hub

# ---- Site ------------------------------------------------------------------
# Canonical public origin — consumed via src/lib/site.ts by the root
# layout's metadataBase + OpenGraph/Twitter cards (per-route through the
# pageMetadata() factory), /robots.txt, /sitemap.xml and /manifest.json.
# NEXT_PUBLIC_* values are INLINED AT BUILD TIME — set this
# BEFORE `bun run build` in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Session signing secret for HMAC cookie auth.
# REQUIRED in production: generate with `openssl rand -hex 32`.
# Must be at least 16 characters — in production a missing or shorter
# value FAILS HARD AT BOOT (session-170: src/instrumentation.ts →
# src/lib/boot-env.ts refuses to serve — the [boot] message names this
# file and the openssl command; the session-169 first-session-op throw
# is the runtime backstop). Dev/test fall back to the
# insecure dev-only constant with a server warning.
AUTH_SECRET=""

# ---- Auth hardening (session-163, the digma port) ---------------------------
# Declared proxy-topology trust depth for the rate-limit IP keying.
# unset (default) = 1 — exactly one appending proxy (the LAST
# x-forwarded-for hop is the real client IP). 0 = direct exposure (the
# client-suppliable XFF/x-real-ip headers are ignored; every caller shares
# one "unknown" bucket). N >= 2 = N trusted appending proxies (keys on the
# hop the Nth trusted proxy preserved). Unparsable/negative values fail
# CLOSED onto 1 — a bad env var never widens trust.
WELLNESS_PROXY_HOPS=""

# Self-hosted in-app delivery kill-switches (the digma ADR-014 family).
# A deployment with a real mail transport sets these to "1": the signup/
# resend responses stop carrying the verification code and the
# forgot-password response stops carrying the reset link (an email service
# owns the delivery; the no-enumeration 200 is unchanged either way).
WELLNESS_DISABLE_IN_APP_OTP=""
WELLNESS_DISABLE_IN_APP_RESET=""
